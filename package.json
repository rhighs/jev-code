{
  "name": "jev-code",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Jev decisions, routing, programs, and validated formal trees.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jev-code": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/sdk.md",
    "examples/router.ts",
    "examples/dependency-tree.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "test:package": "tsx --test test/package-contract.contract.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.20.0"
  }
}
