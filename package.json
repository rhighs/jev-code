{
  "name": "jev-code",
  "version": "0.3.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "description": "Typed Jev decisions, routing, programs, and validated formal trees.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "jev-code": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/sdk.md",
    "examples/router.ts",
    "examples/dependency-tree.ts",
    "README.md"
  ],
  "scripts": {
    "clean": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && bun run build:types",
    "build:types": "tsc",
    "build:binary": "bun run clean && bun build src/cli.ts --compile --outfile dist/jev-code",
    "dev": "bun src/cli.ts",
    "start": "bun dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test --timeout 60000",
    "test:package": "bun test ./test/package-contract.contract.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1"
  }
}
